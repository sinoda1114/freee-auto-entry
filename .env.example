# freee Developers で発行したOAuthアプリの認証情報
# https://app.secure.freee.co.jp/developers のアプリ管理 > 新規追加 で取得する
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# freee側アプリ設定のコールバックURLと一致させること
FREEE_REDIRECT_URI=http://localhost:3000/api/auth/callback/freee

# サーバーサイドでセッション/トークンを暗号化するためのランダム文字列
# 生成例: openssl rand -base64 32
AUTH_SECRET=

# 絶対URLが必要な箇所で使用（ハードコード禁止）
# Android Suica アプリの BuildConfig.SITE_URL も同じ値に合わせる
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 経費登録を許可する事業所 ID（カンマ区切り可。省略時: Waalsforce + 篠田 ITサービス）
# FREEE_EXPENSE_COMPANY_IDS があれば FREEE_EXPENSE_COMPANY_ID より優先
FREEE_EXPENSE_COMPANY_IDS=11122591,11040830
# FREEE_EXPENSE_COMPANY_ID=11122591

# 定型請求テンプレートと作成履歴を保存するTurso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ルール作成フォームの AI 提案（Gemini 3.1 Flash Lite）。ボタン押下時のみ使用
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 省略時: gemini-3.1-flash-lite（AI相談の Lite / 分類用、他機能の既定も兼ねる）
# GEMINI_MODEL=gemini-3.1-flash-lite
# AI相談の難しい質問向け。省略時: gemini-3.5-flash
# GEMINI_MODEL_HARD=gemini-3.5-flash

# 勘定科目の迷いゾーン向け JEV（TypeSafe System One / 二段 Choice）
# 未設定または JEV_ENABLED が 1 以外、あるいはキー無し → 既存 Gemini のみ（現行どおり）
# JEV_ENABLED=1
# JEV_API_KEY=
# キーの別名: TYPESAFE_API_KEY または AI_GATEWAY_API_KEY
# 既定は TypeSafe 直。Vercel AI Gateway を使う場合は base URL を差し替える
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
# JEV_MODEL=jev-latest
# 0〜1。L1/L2 のどちらかがこの値未満なら Gemini へフォールバック
# JEV_MIN_CONFIDENCE=0.6
